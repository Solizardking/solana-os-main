# ── Clawd OS Environment ─────────────────────────────────────────────────────
# Copy to .env and fill in your values before running `npm run dev` or building.

# ── Solana / Helius ──────────────────────────────────────────────────────────
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# ── Market data ──────────────────────────────────────────────────────────────
BIRDEYE_API_KEY=YOUR_BIRDEYE_API_KEY

# ── MiniMax AI (default model: minimax-m3) ───────────────────────────────────
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY
MINIMAX_MODEL=minimax-m3
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# ── AssemblyAI (STT + Voice Agent + LLM Gateway) ────────────────────────────
ASSEMBLY_AI_API_KEY=YOUR_ASSEMBLYAI_API_KEY

# ── LiveKit (real-time audio/video) ─────────────────────────────────────────
LIVEKIT_PROJECT_URL=wss://solanaos-zn3w8h4f.livekit.cloud
LIVEKIT_TOKEN_SERVERURL=https://openclawd-286c1w.sandbox.livekit.io
LIVEKIT_TOKENSANDBOX_ID=openclawd-286c1w
LIVEKIT_PROJECT_ID=p_3zg9niwzqkd
# LiveKit API key+secret — used server-side to generate room tokens
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# ── x402 Payments ────────────────────────────────────────────────────────────
X402_GATEWAY_URL=https://pay.solanaclawd.com
PAY_WALLET_KEYPAIR=            # base58 keypair for autonomous payments

# ── PostHog Analytics (optional, disabled by default) ────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
